<!-- prettier-ignore -->
{% set images = image_fan.images or [] %}
{% set n = images | length %}
{% set gap = image_fan.gap or 1.15 %}            {# card spacing as a multiple of card width #}
{% set closed = image_fan.closed or false %}     {# true = evenly distribute around a full 360 ring #}
{% set direction = image_fan.direction or 'up' %}{# up (rainbow) | down (valley) #}
{% set item_width = image_fan.item_width or 22 %}{# card width as a % of the component width #}
{% set stack = image_fan.stack or 'sequence' %}  {# sequence (array order) | pyramid (centre card on top) #}
{% set class = image_fan.class or '' %}

<!-- prettier-ignore -->
{% set arc = 180 %}
{% if image_fan.arc is defined and image_fan.arc != null %}{% set arc = image_fan.arc %}{% endif %}

<!-- prettier-ignore -->
{% set divisor = n if closed else (n - 1) %}
{% if divisor < 1 %}{% set divisor = 1 %}{% endif %}
{% set step = (360 / divisor) if closed else (arc / divisor) %}
{% set half = (n - 1) / 2 %}

<!-- prettier-ignore -->
<div
  class="image-fan image-fan--{{ direction }}{% if stack == 'pyramid' %} image-fan--pyramid{% endif %} {{ class }}"
  style="--fan-step: {{ step }}; --fan-half: {{ half }}; --fan-gap: {{ gap }}; --fan-item-w: {{ item_width }};"
>
  <div class="image-fan__stage">
    {% for image in images %}
    <figure class="image-fan__item" style="--i: {{ loop.index0 }};">
      <img
        class="image-fan__img"
        src="{{ image.src }}"
        alt="{{ image.alt or '' }}"
        width="{{ image.width or 400 }}"
        height="{{ image.height or 533 }}"
        loading="lazy"
        eleventy:ignore
      />
    </figure>
    {% endfor %}
  </div>
</div>
