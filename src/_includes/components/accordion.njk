<!-- prettier-ignore -->
{% set id = accordion.id or 1 %}
{% set icon = accordion.icon or '' %}
{% set plus = accordion.plus or false %}
{% set single_open = accordion.single_open or false %}
{% set toggle_all = accordion.toggle_all or false %}
{% set toggle_all_text_open = accordion.toggle_all_text_open or 'Open All' %}
{% set toggle_all_text_close = accordion.toggle_all_text_close or 'Close All' %}
{% set items = accordion.items or null %}

<div
  class="accordion"
  id="accordion-{{ id }}"
  data-single-open="{{ single_open }}"
>
  <!-- prettier-ignore -->
  {% if toggle_all and not single_open %}
    {% set btn = ({
      text: toggle_all_text_open,
      type: 'outline',
      size: 'sm',
      class: 'accordion-toggle-all',
      attributes: 'aria-expanded="false" aria-controls="accordion-' ~ id ~ '" data-text-open="' ~ toggle_all_text_open ~ '" data-text-close="' ~ toggle_all_text_close ~ '"'
    }) %}
    {% include "./btn.njk" %}
  {% endif %}
  
  {% for item in items %}
  <div class="accordion-item">
    <!-- prettier-ignore -->
    <button
      class="accordion-btn accordion-label tab-element-page"
      {%if item.content_start%}
        id="content-start"
      {%endif%}
      aria-expanded="false"
      aria-controls="accordion-{{ id }}-item-{{ loop.index }}"
    >
      <span class="accordion-label__title">{{ item.title }}</span>

      {% if icon %}
        {% set icon_svg = ({ src: icon, class: 'accordion-label__icon' }) %}
        {% include "./icon-svg.njk" %}
      {% endif %}

      <!-- prettier-ignore -->
      {% if plus %}
      <span class="accordion-label__plus" aria-hidden="true">
        <span class="accordion-label__plus-line"></span>
        <span class="accordion-label__plus-line"></span>
      </span>
      {% endif %}
    </button>
    <div
      class="accordion-content"
      id="accordion-{{ id }}-item-{{ loop.index }}"
    >
      <div class="accordion-content__inner">
        <p class="accordion-content__message">{{ item.content | safe }}</p>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
