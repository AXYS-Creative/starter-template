<!-- prettier-ignore -->
{% set pre_image = hero_image_circle.pre_image or null %}
{% set title = hero_image_circle.title | default('No title provided') %}
{% set description = hero_image_circle.description | default('No description provided') %}
{% set cta_1 = hero_image_circle.cta_1 or null %}
{% set cta_2 = hero_image_circle.cta_2 or null %}
{% set images_1 = hero_image_circle.images_1 or [] %}
{% set images_2 = hero_image_circle.images_2 or [] %}
{% set direction = hero_image_circle.direction or 'center' %}{# center | left — center (default) flanks the content with two circles; left drops the second circle, shifts the copy left, and lets the first circle overflow off the right edge of the screen. Desktop (lg and up) only — mobile (lg and down) looks the same either way #}
{% set images_scrub = hero_image_circle.images_scrub or 0 %}{# number, 0 (default) = off. Spins each circle on scroll while the section is in the viewport — 1 ≈ a quarter turn (90deg) across the section's full pass through the viewport, so higher = more dramatic. The two circles counter-rotate, matching their idle spin directions #}
{% set images_1_bloom = 'left' if direction == 'left' else 'right' %}{# keep the circle's upright card facing the content, whichever edge it ends up pinned to #}

<section class="hero-image-circle hero-image-circle--{{ direction }}">
  <div class="hero-image-circle__inner">
    <div class="hero-image-circle__images hero-image-circle__images--1">
      <!-- prettier-ignore -->
      {% set image_circle = ({
        images: images_1,
        direction: 'left',
        bloom: images_1_bloom
      }) %}
      <div class="hero-image-circle__spin"{% if images_scrub > 0 %} data-images-scrub="{{ images_scrub }}" data-images-scrub-dir="-1"{% endif %}>
        {% include "../components/image-circle.njk" %}
      </div>
    </div>

    <div class="hero-image-circle__content">
      <!-- prettier-ignore -->
      {% if pre_image and pre_image.src %}
      <img
        class="hero-image-circle__pre-image"
        src="{{ pre_image.src }}"
        alt="{{ pre_image.alt or '' }}"
      />
      {% endif %}

      <h1 class="hero-image-circle__title">{{ title }}</h1>
      <p class="hero-image-circle__desc">{{ description }}</p>

      <!-- prettier-ignore -->
      {% set content_start = true %}
      {% include "../components/cta-group.njk" %}
      {% set content_start = false %}
    </div>

    {% if direction == 'center' %}
    <div class="hero-image-circle__images hero-image-circle__images--2">
      <!-- prettier-ignore -->
      {% set image_circle = ({
        images: images_2,
        direction: 'right',
        bloom: 'left'
      }) %}
      <div class="hero-image-circle__spin"{% if images_scrub > 0 %} data-images-scrub="{{ images_scrub }}" data-images-scrub-dir="1"{% endif %}>
        {% include "../components/image-circle.njk" %}
      </div>
    </div>
    {% endif %}
  </div>
</section>
